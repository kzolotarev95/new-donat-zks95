[Unit]
Description=ZKS95 Developer donation site
After=network-online.target
Wants=network-online.target
OnFailure=new-donat-zks95-alert.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=zks95
Group=zks95
WorkingDirectory=/opt/new-donat-zks95
EnvironmentFile=/etc/new-donat-zks95/.env
ExecStart=/opt/new-donat-zks95/.venv/bin/gunicorn --config /opt/new-donat-zks95/config/gunicorn.conf.py wsgi:app
ExecReload=/bin/kill -s HUP $MAINPID
ExecStartPost=-/usr/bin/timeout 20s /opt/new-donat-zks95/.venv/bin/python /opt/new-donat-zks95/scripts/notify_service_event.py startup
KillMode=mixed
TimeoutStopSec=40
Restart=always
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/new-donat-zks95
ReadWritePaths=/var/log/new-donat-zks95

[Install]
WantedBy=multi-user.target
