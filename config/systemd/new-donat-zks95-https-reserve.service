[Unit]
Description=ZKS95 reserve HTTPS port configuration
After=nginx.service new-donat-zks95.service

[Service]
Type=oneshot
# System services use root by default; only the SQLite reader drops to zks95.
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code 0 /run/lock/new-donat-zks95-maintenance.lock /usr/bin/python3 /usr/local/libexec/new-donat-zks95/reconcile_https_reserve.py
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
StateDirectory=new-donat-zks95-network
StateDirectoryMode=0755
